# ── Original vars (unchanged) ────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/gameplatform?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here
PORT=5000
CLIENT_URL=http://localhost:5173

# ── Feature 3: Google OAuth ───────────────────────────────────
# Get these from: https://console.cloud.google.com → APIs & Services → Credentials
# Create OAuth 2.0 Client ID → Web application
# Authorized redirect URI: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
SERVER_URL=http://localhost:5000
